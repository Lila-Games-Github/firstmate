{
  "prepare": [
    "scripts/godot-automation.sh",
    "--headless",
    "--editor",
    "--path",
    "prototype-game",
    "--quit"
  ],
  "suite": [
    "prototype-game/tests/run_suite.sh"
  ],
  "max_concurrent": 4,
  "device": [
    "prototype-game/tests/e2e/run_device_flow.sh",
    "--serial",
    "{serial}"
  ],
  "scenarios": {
    "expedition-overhaul": [
      "--expedition-overhaul"
    ],
    "expedition-finale": [
      "--expedition-finale"
    ]
  },
  "phones": [
    "R5CT32HRVNM",
    "RZCX224VH4T",
    "RZ8N71EC9ZB"
  ],
  "landing_branch": "proto/godot/frog-pile",
  "landing_gates": [
    "real-phone"
  ],
  "repos": [
    "frogpile",
    "FrogPile",
    "ProjectWhite"
  ],
  "any_phones": [
    "R5CT32HRVNM",
    "RZCX224VH4T"
  ],
  "equivalent_phones": {
    "R5CT32HRVNM": [
      "RZCX224VH4T"
    ],
    "RZCX224VH4T": [
      "R5CT32HRVNM"
    ]
  },
  "performance": {
    "package": "com.lila.prototype.perfaudit20261102",
    "isolated_package_prefixes": ["com.lila.prototype.perfaudit", "com.lila.prototype.perf"],
    "queue": ["@service/fm-perf-phone-queue.py", "--serial", "{device}", "{worktree}/prototype-game/tests/e2e/phone_queue.py"],
    "build": ["@service/fm-perf-frogpile.py", "build", "{worktree}", "{bundle}"],
    "install": ["@service/fm-perf-frogpile.py", "install", "{worktree}", "{bundle}", "--device", "{device}"],
    "drive": ["@service/fm-perf-frogpile.py", "drive", "{worktree}", "{bundle}", "--device", "{device}", "--state", "{state}", "--repeat", "{repeat}"],
    "capture": ["@service/fm-perf-frogpile.py", "capture", "{worktree}", "{bundle}", "--device", "{device}", "--state", "{state}", "--repeat", "{repeat}", "--kind", "{kind}", "--output", "{output}"],
    "pull": ["@service/fm-perf-frogpile.py", "pull", "{worktree}", "{bundle}", "--device", "{device}"],
    "uninstall": ["@service/fm-perf-frogpile.py", "uninstall", "{worktree}", "{bundle}", "--device", "{device}"]
  }
}
